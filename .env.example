# Optional hosted Renime API base URL (leave blank to use the built-in direct provider adapters; do not include /api)
RENIME_API_BASE_URL=
# animesalt or watchanimeworld
RENIME_DEFAULT_PROVIDER=animesalt

# Optional Anivexa multi-provider API base URL (without trailing slash)
ANIVEXA_API_BASE_URL=

# Neon Postgres (later account/database setup)
DATABASE_URL=

# Public production origin used for canonical URLs and sitemap generation (set to the Vercel production domain)
NEXT_PUBLIC_SITE_URL=

# Firebase web app configuration (public client values; set in local and Cloudflare environments)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=
